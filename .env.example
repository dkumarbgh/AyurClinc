# Server
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string

# Default admin account (created by `npm run seed`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Database
DB_PATH=./clinic.db

# WhatsApp — leave WHATSAPP_PROVIDER=none to stub/log messages only.
# Set to "twilio" or "meta" once you have credentials.
WHATSAPP_PROVIDER=none

# --- Twilio WhatsApp API (used when WHATSAPP_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Meta WhatsApp Cloud API (used when WHATSAPP_PROVIDER=meta) ---
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=

# Reminder scheduling
VACCINE_REMINDER_DAYS_BEFORE=3
REMINDER_CRON_SCHEDULE=0 9 * * *
